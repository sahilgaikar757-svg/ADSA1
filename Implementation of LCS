import java.util.*;

public class Main {

    // LCS_LENGTH
    static int[][] LCS_LENGTH(String X, String Y) {

        int m = X.length();
        int n = Y.length();

        // Create DP table
        int[][] dp = new int[m + 1][n + 1];

        for (int i = 1; i <= m; i++) {

            for (int j = 1; j <= n; j++) {

                if (X.charAt(i - 1) == Y.charAt(j - 1)) {
                    dp[i][j] = dp[i - 1][j - 1] + 1;
                }
                else {
                    dp[i][j] = Math.max(dp[i - 1][j], dp[i][j - 1]);
                }
            }
        }

        return dp;
    }

    // BUILD_LCS
    static String BUILD_LCS(String X, String Y, int[][] dp) {

        int i = X.length();
        int j = Y.length();

        StringBuilder result = new StringBuilder();

        while (i > 0 && j > 0) {

            if (X.charAt(i - 1) == Y.charAt(j - 1)) {

                result.append(X.charAt(i - 1));

                i--;
                j--;
            }
            else if (dp[i - 1][j] >= dp[i][j - 1]) {

                i--;
            }
            else {

                j--;
            }
        }

        // Reverse because characters were added from end
        return result.reverse().toString();
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter first string: ");
        String X = sc.next();

        System.out.print("Enter second string: ");
        String Y = sc.next();

        // Create DP table
        int[][] dp = LCS_LENGTH(X, Y);

        // Find actual LCS
        String lcs = BUILD_LCS(X, Y, dp);

        // Display DP table
        System.out.println("\nLCS DP Table:");

        for (int i = 0; i <= X.length(); i++) {

            for (int j = 0; j <= Y.length(); j++) {
                System.out.print(dp[i][j] + "\t");
            }

            System.out.println();
        }

        // Display result
        System.out.println("\nLength of LCS: " + dp[X.length()][Y.length()]);
        System.out.println("Longest Common Subsequence: " + lcs);

        sc.close();
    }
}