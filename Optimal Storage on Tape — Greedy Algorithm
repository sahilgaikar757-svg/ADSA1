import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Read number of files
        System.out.print("Enter number of files: ");
        int n = sc.nextInt();

        int[] length = new int[n];

        // Read file lengths
        System.out.print("Enter file lengths: ");
        for (int i = 0; i < n; i++) {
            length[i] = sc.nextInt();
        }

        // Sort the files in ascending order
        for (int i = 0; i < n - 1; i++) {
            for (int j = i + 1; j < n; j++) {

                if (length[i] > length[j]) {
                    int temp = length[i];
                    length[i] = length[j];
                    length[j] = temp;
                }
            }
        }

        int total = 0;
        int retrieval = 0;

        // Calculate total retrieval time
        for (int i = 0; i < n; i++) {
            retrieval = retrieval + length[i];
            total = total + retrieval;
        }

        double average = (double) total / n;

        // Print optimal order
        System.out.print("Optimal order: ");
        for (int i = 0; i < n; i++) {
            System.out.print(length[i] + " ");
        }

        System.out.println();

        // Print total retrieval time
        System.out.println("Total Retrieval Time: " + total);

        // Print average retrieval time
        System.out.printf("Average Retrieval Time: %.2f%n", average);

        sc.close();
    }
}