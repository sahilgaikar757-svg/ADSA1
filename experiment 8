import java.util.*;

public class Main {

    static void LCS(String X, String Y) {

        int m = X.length();
        int n = Y.length();

        int[][] dp = new int[m + 1][n + 1];

        // Create DP table
        for (int i = 1; i <= m; i++) {
            for (int j = 1; j <= n; j++) {

                if (X.charAt(i - 1) == Y.charAt(j - 1)) {
                    dp[i][j] = dp[i - 1][j - 1] + 1;
                } 
                else {
                    dp[i][j] = Math.max(dp[i - 1][j], dp[i][j - 1]);
                }
            }
        }

        // Find LCS
        String result = "";

        int i = m;
        int j = n;

        while (i > 0 && j > 0) {

            if (X.charAt(i - 1) == Y.charAt(j - 1)) {
                result = X.charAt(i - 1) + result;
                i--;
                j--;
            } 
            else if (dp[i - 1][j] >= dp[i][j - 1]) {
                i--;
            } 
            else {
                j--;
            }
        }

        // Print DP Table
        System.out.println("\nLCS DP Table:");

        for (i = 0; i <= m; i++) {
            for (j = 0; j <= n; j++) {
                System.out.print(dp[i][j] + "\t");
            }
            System.out.println();
        }

        // Print result
        System.out.println("\nLength of LCS: " + dp[m][n]);
        System.out.println("Longest Common Subsequence: " + result);
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter first string: ");
        String X = sc.next();

        System.out.print("Enter second string: ");
        String Y = sc.next();

        LCS(X, Y);

        sc.close();
    }
}