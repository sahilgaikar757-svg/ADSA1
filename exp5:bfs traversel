import java.util.Scanner;

public class BFS {

    static int MAX = 100;
    static int[] queue = new int[MAX];
    static int front = -1;
    static int rear = -1;
    static int[] visited = new int[MAX];

    // Add vertex to queue
    static void enqueue(int vertex) {
        if (rear == MAX - 1) {
            return;
        }

        if (front == -1) {
            front = 0;
        }

        rear++;
        queue[rear] = vertex;
    }

    // Remove vertex from queue
    static int dequeue() {
        if (front == -1) {
            return -1;
        }

        int vertex = queue[front];

        if (front == rear) {
            front = -1;
            rear = -1;
        } else {
            front++;
        }

        return vertex;
    }

    // BFS
    static void BFS(int[][] graph, int start, int vertices) {

        // Initially all vertices are unvisited
        for (int i = 0; i < vertices; i++) {
            visited[i] = 0;
        }

        enqueue(start);
        visited[start] = 1;