import java.util.*;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter number of files: ");
        int n = sc.nextInt();

        int[] a = new int[n];

        System.out.print("Enter file sizes: ");
        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }

        // Sort the array
        Arrays.sort(a);

        int t = 0;
        int sum = 0;

        for (int x : a) {
            t += x;
            sum += t;
        }

        System.out.print("Files in ascending order: ");
        for (int x : a) {
            System.out.print(x + " ");
        }

        double mrt = (double) sum / n;

        System.out.printf("\nMean Retrieval Time (MRT): %.2f", mrt);

        sc.close();
    }
}